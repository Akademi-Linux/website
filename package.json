{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build crates/shell --release --target bundler --out-dir ../../src/wasm/pkg --no-pack",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build && node scripts/prerender.js",
    "lint": "eslint .",
    "test": "cargo test -p shell",
    "preview": "node scripts/preview.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/tailwind": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "gh-pages": "^6.2.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "overrides": {
    "@swc/core": "1.13.5"
  }
}
